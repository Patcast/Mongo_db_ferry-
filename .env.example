# Copy to .env. Everything here is optional — with no .env at all the app runs
# in-process on a memory store, which is how it was built before the cluster existed.

# --- Atlas -------------------------------------------------------------------
# MUST be the cluster created through the Atlas Hackathon Sandbox link, or the
# project is ineligible for the finalist round. M10+ with "Latest Version With
# Auto Upgrades" — Free/Flex are pinned to MongoDB 8.0 and can never run $rerank.
MONGODB_URI=
MONGODB_DB=ledger_memory

# memory | mongo. Defaults to mongo when MONGODB_URI is set, memory otherwise.
STORE_MODE=

# --- Search indexes (create in the Atlas UI) ---------------------------------
VERDICT_VEC_INDEX=verdict_vec_idx
VERDICT_TXT_INDEX=verdicts_text_idx
RERANK_MODEL=rerank-2.5

# --- Demo determinism --------------------------------------------------------
# Pin "today" so expiry/staleness maths give identical numbers in every rehearsal.
AS_OF=2026-08-13T12:00:00Z

PORT=3000
